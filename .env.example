# Copy to .env. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins for local Vite. Leave empty when the UI is served by Django.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. When empty, routing uses the public OSRM server and geocoding uses Photon.
MAPBOX_TOKEN=

# Optional override for tests or a private OSRM.
OSRM_BASE_URL=https://router.project-osrm.org

# Seconds. In-process cache of Open-Meteo hourly series.
WEATHER_CACHE_TTL=1800

# Directory containing the built frontend (Docker sets this).
# FRONTEND_DIST=
